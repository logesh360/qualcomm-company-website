    <nav class="navbar">
      <a href="/" class="logo">QUALCOMM</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/products">Products</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/innovation">Innovation</a></li>
        <li><a href="/careers">Careers</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </nav>
  </header>

  <!-- Hero Section -->
  <section class="innovation-hero">
    <div class="hero-content">
      <h1>Innovation Hub</h1>
      <p class="hero-subtitle">Shaping the future of wireless technology</p>
    </div>
  </section>

  <!-- Innovation Cards -->
  <section class="innovation-section">
    <div class="innovation-grid">
      <div class="innovation-card fade-in">
        <div class="innovation-icon">5️⃣</div>
        <h3>5G Technology</h3>
        <p>Leading the evolution of 5G networks with ultra-low latency, increased bandwidth, and enhanced reliability for next-generation applications.</p>
        <span class="innovation-tag">Connectivity</span>
        <span class="innovation-tag">Wireless</span>
      </div>

      <div class="innovation-card fade-in">
        <div class="innovation-icon">🤖</div>
        <h3>AI Acceleration</h3>
        <p>Pioneering on-device artificial intelligence with specialized AI engines that bring machine learning capabilities directly to edge devices.</p>
        <span class="innovation-tag">AI</span>
        <span class="innovation-tag">Machine Learning</span>
      </div>

      <div class="innovation-card fade-in">
        <div class="innovation-icon">🏠</div>
        <h3>IoT Solutions</h3>
        <p>Building the Internet of Things ecosystem with connected platforms for smart cities, industrial automation, and consumer devices.</p>
        <span class="innovation-tag">IoT</span>
        <span class="innovation-tag">Smart Devices</span>
      </div>

      <div class="innovation-card fade-in">
        <div class="innovation-icon">🚗</div>
        <h3>Autonomous Vehicles</h3>
        <p>Enabling self-driving technology through advanced processors and connectivity solutions for the future of transportation.</p>
        <span class="innovation-tag">Automotive</span>
        <span class="innovation-tag">Autonomous</span>
      </div>

      <div class="innovation-card fade-in">
        <div class="innovation-icon">🔒</div>
        <h3>Cybersecurity</h3>
        <p>Ensuring device security with advanced encryption, authentication, and protection mechanisms built into our processors.</p>
        <span class="innovation-tag">Security</span>
        <span class="innovation-tag">Privacy</span>
      </div>

      <div class="innovation-card fade-in">
        <div class="innovation-icon">⚡</div>
        <h3>Power Efficiency</h3>
        <p>Maximizing battery life and reducing power consumption through innovative chip design and energy management technologies.</p>
        <span class="innovation-tag">Efficiency</span>
        <span class="innovation-tag">Sustainability</span>
      </div>
    </div>
  </section>

  <!-- Timeline Section -->
  <section class="timeline">
    <h2 class="timeline-title">Our Innovation Journey</h2>
    <div class="timeline-items">
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-year">1985</div>
          <div class="timeline-text">Qualcomm founded, pioneering CDMA wireless technology</div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-year">2000</div>
          <div class="timeline-text">Launch of Snapdragon processor series for mobile devices</div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-year">2011</div>
          <div class="timeline-text">First 4G LTE modem revolutionizes mobile networks</div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-year">2018</div>
          <div class="timeline-text">Launch of first commercial 5G modems and chips</div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-year">2021</div>
          <div class="timeline-text">AI accelerators integrated into Snapdragon processors</div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-year">2024</div>
          <div class="timeline-text">Leading the charge in 5G Advanced and 6G research</div>
        </div>
      </div>
    </div>
  </section>

