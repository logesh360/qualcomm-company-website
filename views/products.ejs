      <div class="product-card fade-in">
        <div class="product-image">📱</div>
        <div class="product-info">
          <span class="product-category">Mobile Processors</span>
          <h3 class="product-name">Snapdragon Series</h3>
          <p class="product-description">The world's fastest mobile processors delivering premium performance and efficiency for smartphones and tablets.</p>
