      <!-- AI Engine -->
      <div class="product-card fade-in">
        <div class="product-image">🤖</div>
        <div class="product-info">
          <span class="product-category">AI & ML</span>
          <h3 class="product-name">AI Accelerators</h3>
          <p class="product-description">Specialized AI accelerators for on-device machine learning with ultra-low latency and power efficiency.</p>
          <ul class="product-features">
            <li>On-device inference</li>
            <li>Low power operation</li>
            <li>Real-time processing</li>
            <li>Privacy-first approach</li>
          </ul>
          <button class="product-btn">Learn More</button>
