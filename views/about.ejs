  <!-- Hero Section -->
  <section class="about-hero">
    <div class="hero-content">
      <h1>About Qualcomm</h1>
      <p class="hero-subtitle">Pioneering wireless innovation since 1985</p>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="mission-section">
    <div class="mission-content">
      <div class="mission-text">
        <h2>Our Mission</h2>
        <p>To enable the benefits of wireless technology for everyone, everywhere. We believe in the power of innovation to solve problems and improve lives through connected experiences.</p>
        <p>For nearly four decades, we've been driving advancements in mobile technology, 5G, IoT, and artificial intelligence. Our mission guides every decision we make and every technology we develop.</p>
        <p>We're committed to being a leader in the wireless technology industry, supporting the next generation of innovations that will shape the future of human connectivity.</p>
      </div>
      <div class="mission-image">🎯</div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="values-section">
    <h2>Our Core Values</h2>
    <div class="values-grid">
      <div class="value-card fade-in">
        <div class="value-icon">💡</div>
        <h3>Innovation</h3>
        <p>We push the boundaries of what's possible, constantly seeking new ways to solve problems and create breakthrough technologies.</p>
      </div>
      <div class="value-card fade-in">
        <div class="value-icon">🤝</div>
        <h3>Collaboration</h3>
        <p>We work together with partners, customers, and teams globally to build solutions that benefit everyone.</p>
      </div>
      <div class="value-card fade-in">
        <div class="value-icon">🌍</div>
        <h3>Responsibility</h3>
        <p>We're committed to operating sustainably and responsibly, considering the impact of our actions on society and the environment.</p>
      </div>
      <div class="value-card fade-in">
        <div class="value-icon">⚡</div>
        <h3>Excellence</h3>
        <p>We strive for excellence in everything we do, from product quality to customer service to workplace culture.</p>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="team-section">
    <h2>Our Leadership Team</h2>
    <div class="team-grid">
      <div class="team-member fade-in">
        <div class="member-avatar">👨‍💼</div>
        <h3 class="member-name">Cristiano Amon</h3>
        <p class="member-position">President & Chief Executive Officer</p>
        <p class="member-bio">Leading Qualcomm's vision with decades of experience in semiconductor and mobile technology industries.</p>
      </div>
      <div class="team-member fade-in">
        <div class="member-avatar">👨‍💻</div>
        <h3 class="member-name">James H. Thompson</h3>
        <p class="member-position">Chief Technology Officer</p>
        <p class="member-bio">Driving innovation in 5G, AI, and next-generation wireless technologies with technical expertise.</p>
      </div>
      <div class="team-member fade-in">
        <div class="member-avatar">👩‍💼</div>
        <h3 class="member-name">Sarah Johnson</h3>
        <p class="member-position">Chief Financial Officer</p>
        <p class="member-bio">Managing financial strategy and operations with a focus on sustainable growth and value creation.</p>
      </div>
      <div class="team-member fade-in">
        <div class="member-avatar">👨‍🔬</div>
        <h3 class="member-name">Dr. Michael Chen</h3>
        <p class="member-position">VP of Research & Development</p>
        <p class="member-bio">Leading breakthrough research initiatives in wireless technologies and semiconductor innovation.</p>
      </div>
    </div>
  </section>

