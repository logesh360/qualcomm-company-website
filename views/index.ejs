<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Qualcomm - Transforming Tomorrow's Technology Today</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
</head>
<body>
  <!-- Navigation -->
  <header>
    <nav class="navbar">
      <a href="/" class="logo">QUALCOMM</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/products">Products</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/innovation">Innovation</a></li>
        <li><a href="/careers">Careers</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </nav>
  </header>

  <!-- Hero Section with Story -->
  <section class="hero">
    <div class="hero-content">
      <h1 class="fade-in">The Future is Connected</h1>
      <p class="hero-subtitle fade-in">Discover how Qualcomm is shaping the future of wireless technology</p>
      <div class="hero-buttons fade-in">
        <button class="btn btn-primary" onclick="window.location.href='/products'">Explore Products</button>
        <button class="btn btn-secondary" onclick="window.location.href='/about'">Learn Our Story</button>
      </div>
    </div>
  </section>

  <!-- Story Section -->
  <section class="story-section">
    <h2>Our Journey</h2>
    <div class="story-grid">
      <div class="story-card fade-in">
        <h3>🚀 Innovation Since 1985</h3>
        <p>Founded on the principle of connecting people wirelessly, Qualcomm has been pioneering mobile technology for nearly four decades. From 2G to 5G, we've been at the forefront of innovation.</p>
      </div>
      <div class="story-card fade-in">
        <h3>🌍 Global Impact</h3>
        <p>Today, Qualcomm technologies power billions of devices worldwide. Our commitment to innovation ensures that everyone stays connected, informed, and entertained anywhere, anytime.</p>
      </div>
      <div class="story-card fade-in">
        <h3>💡 Revolutionary Technology</h3>
        <p>From Snapdragon processors to 5G solutions, our technologies are transforming industries. We're enabling autonomous vehicles, IoT devices, and next-generation computing experiences.</p>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="stats-grid">
      <div class="stat-item">
        <h3>50B+</h3>
        <p>Devices Powered</p>
      </div>
      <div class="stat-item">
        <h3>190+</h3>
        <p>Countries Served</p>
      </div>
      <div class="stat-item">
        <h3>45K+</h3>
        <p>Employees Worldwide</p>
      </div>
      <div class="stat-item">
        <h3>$40B+</h3>
        <p>Annual Revenue</p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="hero" style="background: linear-gradient(135deg, #764ba2 0%, #667eea 100%); min-height: 50vh;">
    <div class="hero-content">
      <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">Ready to Join the Revolution?</h2>
      <p class="hero-subtitle">Be part of a team that's transforming the future of technology</p>
      <div class="hero-buttons">
        <button class="btn btn-primary" onclick="window.location.href='/careers'">View Careers</button>
        <button class="btn btn-secondary" onclick="window.location.href='/contact'">Get in Touch</button>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="footer-content">
      <div class="footer-section">
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/careers">Careers</a></li>
          <li><a href="/innovation">Innovation</a></li>
          <li><a href="#">Press</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Products</h4>
        <ul>
          <li><a href="/products">Snapdragon</a></li>
          <li><a href="/products">5G Solutions</a></li>
          <li><a href="/products">IoT Platforms</a></li>
          <li><a href="/products">AI Solutions</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Connect</h4>
        <ul>
          <li><a href="/contact">Contact Us</a></li>
          <li><a href="#">Newsletter</a></li>
          <li><a href="#">Blog</a></li>
          <li><a href="#">Support</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2024 Qualcomm Incorporated. All rights reserved.</p>
    </div>
  </footer>

  <script src="/js/script.js"></script>
</body>
</html>
