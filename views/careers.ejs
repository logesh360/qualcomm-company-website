<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Careers - Qualcomm</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/careers.css">
</head>
<body>
  <!-- Navigation -->
  <header>
    <nav class="navbar">
      <a href="/" class="logo">QUALCOMM</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/products">Products</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/innovation">Innovation</a></li>
        <li><a href="/careers">Careers</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </nav>
  </header>

  <!-- Hero Section -->
  <section class="careers-hero">
    <div class="hero-content">
      <h1>Join Our Team</h1>
      <p class="hero-subtitle">Help us shape the future of wireless technology</p>
    </div>
  </section>

  <!-- Open Positions -->
  <section class="careers-section">
    <h2 style="text-align: center; font-size: 2.5rem; margin-bottom: 3rem; color: #333;">Open Positions</h2>
    <div class="jobs-grid">
      <!-- Job 1 -->
      <div class="job-card fade-in">
        <div class="job-header">
          <div>
            <h3 class="job-title">Senior Software Engineer</h3>
          </div>
          <span class="job-level">Senior</span>
        </div>
        <div class="job-meta">
          <div class="job-meta-item">📍 <span>San Diego, CA</span></div>
          <div class="job-meta-item">💼 <span>Full-time</span></div>
        </div>
        <p class="job-description">Lead development of next-generation 5G and AI software solutions. Work with cutting-edge technologies and a world-class team.</p>
        <div class="job-requirements">
          <h4>Requirements:</h4>
          <ul>
            <li>5+ years software development experience</li>
            <li>Strong C++ and Python skills</li>
            <li>Experience with wireless protocols</li>
            <li>Bachelor's degree in Computer Science</li>
          </ul>
        </div>
        <button class="apply-btn" onclick="document.getElementById('applicationModal').classList.add('active');">Apply Now</button>
      </div>

      <!-- Job 2 -->
      <div class="job-card fade-in">
        <div class="job-header">
          <div>
            <h3 class="job-title">Hardware Design Engineer</h3>
          </div>
          <span class="job-level">Mid-Level</span>
        </div>
        <div class="job-meta">
          <div class="job-meta-item">📍 <span>San Diego, CA</span></div>
          <div class="job-meta-item">💼 <span>Full-time</span></div>
        </div>
        <p class="job-description">Design and optimize high-performance semiconductor devices. Collaborate with cross-functional teams on chip architecture and verification.</p>
        <div class="job-requirements">
          <h4>Requirements:</h4>
          <ul>
            <li>3+ years chip design experience</li>
            <li>Proficiency in Verilog/VHDL</li>
            <li>Knowledge of digital design methodologies</li>
            <li>Master's degree in EE or related field</li>
          </ul>
        </div>
        <button class="apply-btn" onclick="document.getElementById('applicationModal').classList.add('active');">Apply Now</button>
      </div>

      <!-- Job 3 -->
      <div class="job-card fade-in">
        <div class="job-header">
          <div>
            <h3 class="job-title">AI/ML Research Scientist</h3>
          </div>
          <span class="job-level">Senior</span>
        </div>
        <div class="job-meta">
          <div class="job-meta-item">📍 <span>Santa Clara, CA</span></div>
          <div class="job-meta-item">💼 <span>Full-time</span></div>
        </div>
        <p class="job-description">Conduct research and develop advanced AI algorithms for on-device inference. Push the boundaries of machine learning innovation.</p>
        <div class="job-requirements">
          <h4>Requirements:</h4>
          <ul>
            <li>PhD in Machine Learning or related field</li>
            <li>Published research in top-tier venues</li>
            <li>Deep learning framework expertise</li>
            <li>Strong publication record</li>
          </ul>
        </div>
        <button class="apply-btn" onclick="document.getElementById('applicationModal').classList.add('active');">Apply Now</button>
      </div>

      <!-- Job 4 -->
      <div class="job-card fade-in">
        <div class="job-header">
          <div>
            <h3 class="job-title">Product Manager</h3>
          </div>
          <span class="job-level">Mid-Level</span>
        </div>
        <div class="job-meta">
          <div class="job-meta-item">📍 <span>San Diego, CA</span></div>
          <div class="job-meta-item">💼 <span>Full-time</span></div>
        </div>
        <p class="job-description">Drive product strategy and vision for our 5G and IoT solutions. Work closely with engineering and go-to-market teams.</p>
        <div class="job-requirements">
          <h4>Requirements:</h4>
          <ul>
            <li>5+ years product management experience</li>
            <li>Experience in wireless/telecom industry</li>
            <li>Strong analytical and communication skills</li>
            <li>Bachelor's degree in related field</li>
          </ul>
        </div>
        <button class="apply-btn" onclick="document.getElementById('applicationModal').classList.add('active');">Apply Now</button>
      </div>

      <!-- Job 5 -->
      <div class="job-card fade-in">
        <div class="job-header">
          <div>
            <h3 class="job-title">Systems Analyst</h3>
          </div>
          <span class="job-level">Entry-Level</span>
        </div>
        <div class="job-meta">
          <div class="job-meta-item">📍 <span>Austin, TX</span></div>
          <div class="job-meta-item">💼 <span>Full-time</span></div>
        </div>
        <p class="job-description">Analyze complex wireless systems and contribute to next-generation technology development. Support senior engineers on key projects.</p>
        <div class="job-requirements">
          <h4>Requirements:</h4>
          <ul>
            <li>Bachelor's degree in Engineering or CS</li>
            <li>Strong problem-solving skills</li>
            <li>Familiarity with wireless systems</li>
            <li>Excellent communication abilities</li>
          </ul>
        </div>
        <button class="apply-btn" onclick="document.getElementById('applicationModal').classList.add('active');">Apply Now</button>
      </div>

      <!-- Job 6 -->
      <div class="job-card fade-in">
        <div class="job-header">
          <div>
            <h3 class="job-title">QA Engineer</h3>
          </div>
          <span class="job-level">Entry-Level</span>
        </div>
        <div class="job-meta">
          <div class="job-meta-item">📍 <span>Hyderabad, India</span></div>
          <div class="job-meta-item">💼 <span>Full-time</span></div>
        </div>
        <p class="job-description">Ensure quality of our cutting-edge products through rigorous testing and quality assurance procedures on wireless technologies.</p>
        <div class="job-requirements">
          <h4>Requirements:</h4>
          <ul>
            <li>Bachelor's degree in IT or related field</li>
            <li>Knowledge of QA methodologies</li>
            <li>Test automation experience</li>
            <li>Attention to detail</li>
          </ul>
        </div>
        <button class="apply-btn" onclick="document.getElementById('applicationModal').classList.add('active');">Apply Now</button>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="benefits-section">
    <h2>Why Work at Qualcomm?</h2>
    <div class="benefits-grid">
      <div class="benefit-item fade-in">
        <div class="benefit-icon">💰</div>
        <h3>Competitive Compensation</h3>
        <p>Industry-leading salaries and comprehensive benefits packages to support your lifestyle and goals.</p>
      </div>
      <div class="benefit-item fade-in">
        <div class="benefit-icon">📚</div>
        <h3>Continuous Learning</h3>
        <p>Access to professional development programs, training, and educational opportunities to grow your skills.</p>
      </div>
      <div class="benefit-item fade-in">
        <div class="benefit-icon">🏥</div>
        <h3>Health & Wellness</h3>
        <p>Comprehensive health insurance, fitness programs, and mental wellness support for you and your family.</p>
      </div>
      <div class="benefit-item fade-in">
        <div class="benefit-icon">⚖️</div>
        <h3>Work-Life Balance</h3>
        <p>Flexible work arrangements and generous time-off policies to maintain a healthy work-life balance.</p>
      </div>
      <div class="benefit-item fade-in">
        <div class="benefit-icon">🌍</div>
        <h3>Global Opportunities</h3>
        <p>Work with talented colleagues from around the world and explore career opportunities globally.</p>
      </div>
      <div class="benefit-item fade-in">
        <div class="benefit-icon">🚀</div>
        <h3>Innovation Culture</h3>
        <p>Be part of a company that's shaping the future with cutting-edge technology and groundbreaking products.</p>
      </div>
    </div>
  </section>

  <!-- Application Modal -->
  <div id="applicationModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Apply for <span id="modalPosition"></span></h2>
        <button class="close-btn" onclick="document.getElementById('applicationModal').classList.remove('active');">&times;</button>
      </div>
      <form id="applicationForm" class="modal-form">
        <input type="text" id="appName" placeholder="Full Name" required>
        <input type="email" id="appEmail" placeholder="Email Address" required>
        <textarea id="appExperience" placeholder="Tell us about your experience..." style="min-height: 100px;" required></textarea>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Submit Application</button>
      </form>
    </div>
  </div>

  <!-- Footer -->
  <footer>
    <div class="footer-content">
      <div class="footer-section">
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/careers">Careers</a></li>
          <li><a href="/innovation">Innovation</a></li>
          <li><a href="#">Press</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Products</h4>
        <ul>
          <li><a href="/products">Snapdragon</a></li>
          <li><a href="/products">5G Solutions</a></li>
          <li><a href="/products">IoT Platforms</a></li>
          <li><a href="/products">AI Solutions</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Connect</h4>
        <ul>
          <li><a href="/contact">Contact Us</a></li>
          <li><a href="#">Newsletter</a></li>
          <li><a href="#">Blog</a></li>
          <li><a href="#">Support</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2024 Qualcomm Incorporated. All rights reserved.</p>
    </div>
  </footer>

  <script src="/js/script.js"></script>
  <script src="/js/careers.js"></script>
</body>
</html>
